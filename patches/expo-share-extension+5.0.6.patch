+    AsyncFunction("clearShareLog") { () -> Bool in
+      let groupId = Bundle.main.object(forInfoDictionaryKey: "AppGroup") as? String ?? "group.com.harpreetmails.moviedeck"
+      guard let containerURL = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: groupId) else { return false }
+      let logURL = containerURL.appendingPathComponent("share-extension.log")
+      guard FileManager.default.fileExists(atPath: logURL.path) else { return true }
+      do {
+        try FileManager.default.removeItem(at: logURL)
+        return true
+      } catch {
+        return false
+      }
+    }
