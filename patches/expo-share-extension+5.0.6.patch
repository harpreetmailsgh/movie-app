+private extension CharacterSet {
+  // Query-value encoding for the embedded shared URL: also escapes `& = ? + #`
+  // so the URL can't break out of the `sharedUrl` query parameter.
+  static var shareExtensionQueryValueAllowed: CharacterSet {
+    var allowed = CharacterSet.urlQueryAllowed
+    allowed.remove(charactersIn: "&=?+#")
+    return allowed
+  }
+}
