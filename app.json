{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101010",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.harpreetmails.movieapp"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harpreetmails.movieapp"
    },
    "name": "Movie Deck",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-share-extension",
        {
          "activationRules": [{ "type": "url", "max": 1 }, { "type": "text" }],
          "backgroundColor": { "red": 0, "green": 0, "blue": 0, "alpha": 1 },
          "height": 300
        }
      ]
    ],
    "scheme": "movierecommender",
    "slug": "movie-app",
    "splash": {
      "backgroundColor": "#000000",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "dark",
    "version": "1.6.26",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "646085b5-a3c9-4755-8dec-963c6f72223c"
      }
    }
  }
}
